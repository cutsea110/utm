cabal-version:      3.0
name:               utm
version:            0.1.0.0
synopsis:           universal turing machine
-- description:
homepage:           https://github.com/cutsea110/utm
license:            BSD-3-Clause
license-file:       LICENSE
author:             cutsea110
maintainer:         cutsea110@gmail.com
-- copyright:
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall
library
    exposed-modules:  TM
                      Eval
    build-depends:    base ^>=4.22.0.0, containers
    hs-source-dirs:   src
    default-language: GHC2024
    ghc-options:      -Wall
executable utm
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:    base ^>=4.22.0.0, utm
    hs-source-dirs:   app
    default-language: GHC2024
